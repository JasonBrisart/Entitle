# ==================================================
# The Brisart Ecosystem
# Pure Python / Local First / Dependency Free
# ==================================================
# ---------------------------------------------------------------------------
# Entitle runtime data (never source)
#   These directories hold issued entitlement envelopes, the tamper-evident
#   record log, and generated audit reports. They contain operational data and
#   key-bound material, never source, and must never reach the repository.
# ---------------------------------------------------------------------------
entitlements/
records/
reports/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
# Type checkers / linters / test caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
# ---------------------------------------------------------------------------
# Virtual Environments
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
# ---------------------------------------------------------------------------
# OS-generated files
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
# ---------------------------------------------------------------------------
# Local Secrets
# ---------------------------------------------------------------------------
.env
.env.local
.env.development
.env.production
.env.test
# ---------------------------------------------------------------------------
# Generic Cache / Temp / Logs
# ---------------------------------------------------------------------------
.cache/
tmp/
temp/
*.tmp
*.temp
*.lock
logs/
*.log
# ---------------------------------------------------------------------------
# SQLite Databases
# ---------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
# ---------------------------------------------------------------------------
# Project Context Helper
# (shared export tool used across Brisart Ecosystem projects)
# ---------------------------------------------------------------------------
PROJECT_CONTEXT_EXPORTS/
PROJECT_CONTEXT.md
PROJECT_CONTEXT_SETTINGS.json
PROJECT_MANIFEST.json
PROJECT_SUMMARY.txt
PROJECT_SNAPSHOT.zip
# ==================================================
# ArchiveSnapshot
# ==================================================
# Dated snapshot storage created inside archived source folders
ARCHIVE_TIMELINE/
# GUI application settings (per-machine, not part of source)
ARCHIVE_SNAPSHOT_SETTINGS.json
# Headless daily automation config/state/log (per-machine, not source)
DAILY_SNAPSHOT_CONFIG.json
DAILY_SNAPSHOT_STATE.json
DAILY_SNAPSHOT_LOG.md
# Project Context Helper inbox contents (staged files, not source)
SNAPSHOT_ACTIVE/
